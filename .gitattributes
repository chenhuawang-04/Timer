* text=auto

# Source and project metadata should stay LF for Android / Gradle / GitHub Actions.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.gradle text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
gradlew text eol=lf

# Windows batch files should remain CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.jks binary
