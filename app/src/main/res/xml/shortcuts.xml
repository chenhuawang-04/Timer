            android:action="com.timer.app.action.CREATE_ROUTINE_SHORTCUT"
            android:targetClass="com.timer.app.MainActivity"
            android:targetPackage="com.timer.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutDisabledMessage="@string/shortcut_open_focus_short"
        android:shortcutId="open_focus"
        android:shortcutLongLabel="@string/shortcut_open_focus_long"
        android:shortcutShortLabel="@string/shortcut_open_focus_short">
        <intent
            android:action="com.timer.app.action.OPEN_FOCUS"
            android:targetClass="com.timer.app.MainActivity"
            android:targetPackage="com.timer.app" />
